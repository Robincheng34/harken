<?xml version="1.0" encoding="utf-8"?>
<!-- 冷启动窗口背景：纯黑垫底 + 品牌启动图（与 Compose 启动层同一资产，
     消除窗口背景 → 首帧之间的白屏/跳变）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />
    <!-- centerCrop 与 Compose SplashLayer 的 ContentScale.Crop 才是同语义，
         但 XML bitmap gravity 不支持 centerCrop（AAPT 限制），等比裁切需
         预裁资产或换 LayerDrawable 实现——维持 fill（拉伸），跳变问题缓议。 -->
    <item>
        <bitmap
            android:src="@drawable/splash_brand"
            android:gravity="fill" />
    </item>
</layer-list>
