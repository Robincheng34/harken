<?xml version="1.0" encoding="utf-8"?>
<!--
  NetEase 歌曲直链（songURL 返回的 m*.music.126.net CDN）是 HTTP 明文，而本应用
  targetSdk=35，平台默认禁止明文流量。仅对音乐 CDN 放开明文；API 域名 music.163.com
  本就走 HTTPS，不在此列。不做全局 usesCleartextTraffic，避免扩大明文攻击面。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">music.126.net</domain>
        <!-- 灰色解锁第三方音源：酷狗搜索接口仅提供 HTTP（HTTPS 返回空），
             酷我/酷狗音频 CDN 也可能回落明文。仅放行这两个音乐域，不全局开明文。 -->
        <domain includeSubdomains="true">kugou.com</domain>
        <domain includeSubdomains="true">kuwo.cn</domain>
    </domain-config>
</network-security-config>
